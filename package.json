{
  "name": "carpooling-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Nền tảng chia sẻ chuyến đi công sở phi thương mại tại Việt Nam (Monorepo: Laravel 13 + React Vite)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && php artisan serve --port=8000",
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "test:api": "cd apps/api && php artisan test"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
